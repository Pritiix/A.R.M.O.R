# ESP32-CAM stream. Leave blank only to use the deployment host's webcam (index 0).
CAMERA_URL=http://192.168.1.50:81/stream

# A.R.M.O.R. backend WebSocket endpoint for telemetry subscription and alerts.
WS_ENDPOINT=ws://localhost:8000/ws/telemetry

# YOLO model and detection confidence (0.0 to 1.0).
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.50

# Writable Ultralytics configuration location. Use this when the service
# account cannot write to its default user profile directory.
YOLO_CONFIG_DIR=./.ultralytics

# Must stay aligned with backend/app/core/thresholds.py and frontend constants.
# A detected person above warning is a WARNING; above critical is a CRITICAL_SURVIVOR.
TEMPERATURE_WARNING_C=35.0
TEMPERATURE_CRITICAL_C=45.0

# MQ-2 gas is hazardous at either threshold, or when telemetry reports a
# WARNING/CRITICAL/HAZARDOUS/DANGER gas status. It creates CRITICAL_SURVIVOR.
MQ2_HAZARD_RAW_THRESHOLD=300
MQ2_HAZARD_PPM_THRESHOLD=50.0

# A sensor reading older than this is not used to confirm a person.
TELEMETRY_STALE_SECONDS=5.0

# Suppress repeat WebSocket alerts for the same fusion status.
ALERT_COOLDOWN_SECONDS=5.0

# Optional local debugging window. Set true only on a host with a display.
SHOW_PREVIEW=false
LOG_LEVEL=INFO

# Local MJPEG output for the dashboard, including OpenCV detection and fusion
# overlays. Bind to 127.0.0.1 unless a network access policy explicitly allows
# exposing the stream.
VISION_STREAM_HOST=127.0.0.1
VISION_STREAM_PORT=8081
