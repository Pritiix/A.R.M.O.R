# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ----- ESP32 Hardware (set when physical rover is connected) -----
# ROVER_IP=192.168.1.xxx
# ROVER_PORT=81

# ----- Database -----
DATABASE_URL=sqlite:///./armor_local.db

# ----- Telemetry Mode: simulation | live -----
TELEMETRY_MODE=simulation

# ----- Simulation -----
SIM_TICK_INTERVAL_MS=1000
SIM_SCENARIO=NORMAL

# ----- Security (change before any networked deployment) -----
# SECRET_KEY=changeme
# ALLOWED_ORIGINS=http://localhost:5173

# ----- AI / Vision -----
# AI_MODEL_PATH=ai/models/yolov8n.onnx
# AI_CONFIDENCE_THRESHOLD=0.5
