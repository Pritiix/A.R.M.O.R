# ============================================================
# A.R.M.O.R. — .gitignore
# NEVER commit secrets, keys, local configs, or build artifacts
# ============================================================

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.secret
*.key
*.pem
*.cert
*.p12
secrets/
config/local_*.py
config/local_*.ts

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.log

# ----- SQLite / Local Databases -----
*.db
*.sqlite
*.sqlite3
backend/app/database/armor_local.db

# ----- Node / Frontend -----
node_modules/
dist/
.cache/
.parcel-cache/
*.tsbuildinfo
frontend/dist/
frontend/.vite/

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ----- IDE -----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# ----- Build outputs -----
*.map
*.min.js

# ----- AI / Models -----
ai/models/*.pt
ai/models/*.pth
ai/models/*.onnx
ai/models/*.tflite
ai/models/*.weights

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Firmware compiled -----
firmware/**/*.elf
firmware/**/*.hex
firmware/**/*.bin
